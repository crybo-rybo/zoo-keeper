@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ggml-config.cmake references OpenMP::OpenMP_C even when the consumer only
# enables CXX. Find OpenMP first and, if C language is not enabled, create a
# stub so that ggml's set_target_properties succeeds.
if("@ZOO_BUILD_GGML_OPENMP_ENABLED@" STREQUAL "ON")
    find_dependency(OpenMP)
    if(NOT TARGET OpenMP::OpenMP_C AND TARGET OpenMP::OpenMP_CXX)
        add_library(OpenMP::OpenMP_C INTERFACE IMPORTED GLOBAL)
        set_property(TARGET OpenMP::OpenMP_C PROPERTY
            INTERFACE_LINK_LIBRARIES OpenMP::OpenMP_CXX)
    endif()
endif()

find_dependency(llama CONFIG)

# Upstream llama.cpp installs its version file as `llama-version.cmake` rather
# than the CMake-standard `llama-config-version.cmake`, so `find_dependency`
# cannot enforce a version constraint directly. Instead, both `llama-config.cmake`
# and `llama-version.cmake` set LLAMA_BUILD_NUMBER as a CMake variable; verify
# it post-find and fail closed on a mismatch with the value ZooKeeper was built
# against. The fallback include is defensive: it covers patched installs whose
# config file omits the variable.
if("@ZOO_BUILD_LLAMA_BUILD_NUMBER@" AND NOT "@ZOO_BUILD_LLAMA_BUILD_NUMBER@" STREQUAL "0")
    if(NOT DEFINED LLAMA_BUILD_NUMBER)
        set(_zk_llama_version_file "${llama_DIR}/llama-version.cmake")
        if(EXISTS "${_zk_llama_version_file}")
            include("${_zk_llama_version_file}")
        endif()
        unset(_zk_llama_version_file)
    endif()
    if(NOT DEFINED LLAMA_BUILD_NUMBER OR
       NOT "${LLAMA_BUILD_NUMBER}" STREQUAL "@ZOO_BUILD_LLAMA_BUILD_NUMBER@")
        message(FATAL_ERROR
            "ZooKeeper was built against llama.cpp build "
            "@ZOO_BUILD_LLAMA_BUILD_NUMBER@, but the installed llama package "
            "reports build '${LLAMA_BUILD_NUMBER}'. Reinstall a matching "
            "llama.cpp before consuming ZooKeeper.")
    endif()
endif()

find_dependency(nlohmann_json 3.11 CONFIG)

if(NOT TARGET ZooKeeper::llama AND TARGET llama)
    add_library(ZooKeeper::llama INTERFACE IMPORTED)
    # libllama-common.a is installed by zoo_install_llama_common() in
    # cmake/ZooKeeperLlama.cmake. Upstream llama.cpp does not export it from
    # its own CMake package, so consumers reach it by path through us.
    set_property(TARGET ZooKeeper::llama PROPERTY
        INTERFACE_LINK_LIBRARIES
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libllama-common.a"
            "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/libllama-common-base.a"
            llama
    )
endif()

if(NOT TARGET ZooKeeper::nlohmann_json)
    add_library(ZooKeeper::nlohmann_json INTERFACE IMPORTED)
    set_property(TARGET ZooKeeper::nlohmann_json PROPERTY
        INTERFACE_LINK_LIBRARIES nlohmann_json::nlohmann_json
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ZooKeeperTargets.cmake")

check_required_components(ZooKeeper)
